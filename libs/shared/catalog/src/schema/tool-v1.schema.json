{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotln-angular.invalid/tool-v1.schema.json",
  "$ref": "#/$defs/tool",
  "$defs": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "default", "min", "max"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "default": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "typedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params"],
      "properties": {
        "kind": {
          "enum": [
            "steer.blend",
            "steer.priority",
            "formation.twoLevel",
            "formation.fixed",
            "objective.set",
            "squad.form",
            "squad.dissolve",
            "order.issue",
            "channel.policy",
            "ground.influence",
            "ground.frag",
            "path.cost",
            "level.zoom",
            "level.ring"
          ]
        },
        "params": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/param"
          }
        }
      }
    },
    "untypedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "const": "untyped"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "min", "max"],
      "properties": {
        "target": {
          "enum": ["unit", "squad", "commander", "channel", "region", "scene"]
        },
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.jsonl$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "catalogMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "rows", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.jsonl$"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "analog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "clause"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "executor",
              "verifier",
              "reviewer",
              "repairer",
              "planner",
              "refuter",
              "release-close",
              "operator"
            ]
          }
        },
        "clause": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "selection", "transform", "observable", "toyMetric"],
      "properties": {
        "scene": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "units-on-terrain",
              "pipeline",
              "channels",
              "marbles",
              "levels",
              "teams",
              "workplace",
              "builds"
            ]
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "transform": {
          "oneOf": [
            {
              "$ref": "#/$defs/typedTransform"
            },
            {
              "$ref": "#/$defs/untypedTransform"
            }
          ]
        },
        "observable": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "toyMetric": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "work",
        "title",
        "rowType",
        "kind",
        "status",
        "classifiedBy",
        "provenance",
        "map",
        "definition",
        "place",
        "related",
        "hooks",
        "verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[1-9][0-9]*$"
        },
        "work": {
          "enum": [
            "aifg",
            "eip",
            "poeaa",
            "rxjs",
            "geb",
            "tt",
            "artofwar",
            "goal",
            "marquet",
            "gladwell",
            "taleb",
            "altb",
            "meadows",
            "poe",
            "fives",
            "pirsig",
            "poincare"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rowType": {
          "enum": [
            "concept",
            "technique",
            "pattern",
            "principle",
            "tool",
            "trade-off",
            "anti-pattern",
            "data-structure",
            "algorithm",
            "observation"
          ]
        },
        "kind": {
          "enum": [
            "behaviour",
            "rule",
            "mode",
            "relationship",
            "analysis",
            "sceneType",
            "sceneElement",
            "metric",
            "background"
          ]
        },
        "faces": {
          "$ref": "#/$defs/faces"
        },
        "analog": {
          "$ref": "#/$defs/analog"
        },
        "status": {
          "enum": ["typed", "untyped", "background"]
        },
        "classifiedBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "provenance": {
          "enum": ["map", "public-work"]
        },
        "map": {
          "oneOf": [
            {
              "$ref": "#/$defs/map"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chapter"],
          "properties": {
            "part": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "chapter": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "subsection": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "id"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*:[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "clause"],
            "properties": {
              "domain": {
                "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11"]
              },
              "clause": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "verified": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": {
              "enum": ["sourced", "model-knowledge", "partial"]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "map"
              }
            }
          },
          "then": {
            "properties": {
              "map": {
                "$ref": "#/$defs/map"
              }
            }
          },
          "else": {
            "properties": {
              "map": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "background"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["background", "sceneElement", "metric"]
              }
            },
            "not": {
              "required": ["faces"]
            }
          },
          "else": {
            "required": ["faces"],
            "properties": {
              "kind": {
                "enum": ["behaviour", "rule", "mode", "relationship", "analysis", "sceneType"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "typed"
              }
            }
          },
          "then": {
            "properties": {
              "faces": {
                "properties": {
                  "transform": {
                    "$ref": "#/$defs/typedTransform"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "untyped"
              }
            }
          },
          "then": {
            "properties": {
              "faces": {
                "properties": {
                  "transform": {
                    "$ref": "#/$defs/untypedTransform"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "batch", "maps", "tools"],
      "properties": {
        "schema": {
          "const": "tool-v1"
        },
        "batch": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "maps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/catalogMap"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    }
  }
}
