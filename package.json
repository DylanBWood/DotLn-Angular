{
  "name": "@dotln-angular/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve dotln",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "e2e": "nx run-many -t e2e",
    "format": "nx format:write --all",
    "format:check": "nx format:check",
    "lint:fixtures": "node tools/check-lint-fixtures.mjs && node tools/check-taxonomy-fixtures.mjs",
    "test:tooling": "node --test tools/*.test.mjs",
    "typecheck:e2e": "tsc --noEmit -p apps/dotln-e2e/tsconfig.json",
    "boards": "node tools/board-count.mjs",
    "env:prime": "node tools/scripts/prime-environment.mjs",
    "i18n:check": "node tools/scripts/check-i18n.mjs",
    "check:templates": "node tools/scripts/check-template-literals.mjs",
    "check:tokens": "node tools/scripts/check-token-names.mjs",
    "check:kits": "node tools/scripts/check-spec-kits.mjs",
    "typecheck:foundations": "node tools/scripts/check-foundation-types.mjs",
    "lint:components": "node tools/scripts/check-component-order.mjs",
    "check:shared-types": "node tools/scripts/check-shared-types.mjs",
    "check:fixtures": "node tools/scripts/check-board-fixtures.mjs",
    "msw:init": "msw init apps/dotln/public --save",
    "build:configured": "nx build dotln --configuration=configured --skip-nx-cache",
    "lint:hygiene": "node tools/scripts/check-event-hygiene.mjs",
    "check:scripts": "node tools/scripts/check-script-reference.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "22.0.0",
    "@angular/aria": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "@ngrx/signals": "22.0.1",
    "ramda": "0.32.0",
    "ramda-adjunct": "6.1.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.1",
    "@analogjs/vitest-angular": "2.9.1",
    "@angular-devkit/core": "~22.2.3",
    "@angular-devkit/schematics": "~22.2.3",
    "@angular/build": "~22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "~22.2.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/angular-vite": "10.6.3",
    "@swc/helpers": "~0.5.18",
    "@types/node": "26.6.2",
    "@types/ramda": "0.32.0",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "ajv": "8.20.0",
    "angular-eslint": "22.6.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "nx": "23.3.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.2",
    "storybook": "10.6.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "overrides": {
    "nx@23.3.0": {
      "undici": "7.30.1"
    },
    "@angular/build@~22.2.3": {
      "vite": "8.3.3"
    }
  },
  "msw": {
    "workerDirectory": [
      "apps/dotln/public"
    ]
  }
}
