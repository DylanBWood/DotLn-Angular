# These values become public browser configuration. Never put secrets here.
DOTLN_PRODUCTION=false
DOTLN_API_BASE_URL=/api
DOTLN_MOCKS=true
DOTLN_FEATURE_FLAGS={"sourcesFooter":true}
DOTLN_FEATURE_FLAG_OVERRIDES=true
DOTLN_REQUEST_TIMEOUT_MS=10000
DOTLN_I18N_DEFAULT_LANG=en
DOTLN_I18N_AVAILABLE_LANGS=en
DOTLN_AUTH=null
# Development server only; credentials in this URL are refused.
DOTLN_API_PROXY_TARGET=http://127.0.0.1:3000
