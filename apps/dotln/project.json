{
  "name": "dotln",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "dotln",
  "sourceRoot": "apps/dotln/src",
  "tags": ["scope:dotln", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/dotln",
        "browser": "apps/dotln/src/main.ts",
        "tsConfig": "apps/dotln/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dotln/public"
          }
        ],
        "styles": ["apps/dotln/src/styles.scss"],
        "define": {
          "DOTLN_MOCKS_ENABLED": "true"
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/dotln/src/environments/environment.ts",
              "with": "apps/dotln/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/dotln/public",
              "ignore": ["mockServiceWorker.js"]
            }
          ],
          "define": {
            "DOTLN_MOCKS_ENABLED": "false"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/dotln/src/environments/environment.ts",
              "with": "apps/dotln/src/environments/environment.local.ts"
            }
          ]
        },
        "mocked": {
          "optimization": true,
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/dotln/src/environments/environment.ts",
              "with": "apps/dotln/src/environments/environment.mocked.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ]
        },
        "configured": {
          "fileReplacements": [
            {
              "replace": "apps/dotln/src/environments/environment.ts",
              "with": "apps/dotln/src/environments/environment.prod.ts"
            },
            {
              "replace": "apps/dotln/src/environments/public-config.ts",
              "with": "apps/dotln/src/environments/public-config.local.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/dotln/public",
              "ignore": ["mockServiceWorker.js"]
            }
          ],
          "define": {
            "DOTLN_MOCKS_ENABLED": "false"
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/dotln/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "dotln:build:production"
        },
        "development": {
          "buildTarget": "dotln:build:development"
        },
        "local": {
          "buildTarget": "dotln:build:local",
          "proxyConfig": ".nx/dotln/proxy.conf.json"
        },
        "mocked": {
          "buildTarget": "dotln:build:mocked"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "setupFiles": ["apps/dotln/src/test-setup.ts"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "dotln:build:mocked",
        "port": 4200,
        "staticFilePath": "dist/apps/dotln/browser",
        "spa": true
      }
    }
  }
}
