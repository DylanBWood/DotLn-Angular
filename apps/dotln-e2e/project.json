{
  "name": "dotln-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dotln-e2e/src",
  "implicitDependencies": ["dotln", "ui", "board", "dotln-shell"],
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "target": "build-storybook",
          "projects": ["ui"]
        }
      ]
    },
    "e2e-visual": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build-storybook",
          "projects": ["ui"]
        }
      ],
      "options": {
        "command": "npx playwright test --config=apps/dotln-e2e/playwright.visual.config.mts"
      }
    }
  },
  "tags": ["scope:dotln", "type:app"]
}
